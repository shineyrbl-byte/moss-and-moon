# Copy this file to .env.local (for your computer) or paste these into your
# hosting provider's "Variables" settings. Everything is optional.

# Staff dashboard passcode (default: moonlight). PLEASE change this online!
ADMIN_PASSCODE=moonlight

# Your site's public address, used for links inside emails
SITE_URL=http://localhost:3000

# Opening hours are checked in this timezone
TZ=Asia/Kolkata

# Where the database is stored (point this at a persistent disk when hosting)
# DATA_DIR=/data

# --- Real payments (Razorpay: https://dashboard.razorpay.com → Settings → API Keys)
# Use "Test mode" keys first (rzp_test_...) — they take fake payments.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# --- AI barista chat. Without a key, it runs in a simple keyword "demo mode".
# Free option: Google Gemini (https://aistudio.google.com/apikey)
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-3.8-flash
# Paid option (used first if set): Claude (https://console.anthropic.com → API Keys)
# ANTHROPIC_API_KEY=sk-ant-...

# --- Push notifications: keys are created automatically. Only set these if you
# want to manage them yourself (npx web-push generate-vapid-keys)
# VAPID_PUBLIC_KEY=...
# VAPID_PRIVATE_KEY=...
# VAPID_SUBJECT=mailto:you@example.com

# --- Where the nightly summary, error alerts and weekly backup go
# (you can also set this in /admin → Overview)
# OWNER_EMAIL=you@example.com

# --- Real emails from the café Gmail through Gmail's API (works on Railway Hobby; DEPLOY.md step 4)
# GOOGLE_CLIENT_ID=…apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=…
# --- …or through Gmail's mail server, on hosts that allow email ports
# GMAIL_USER=mossandmooncafe@gmail.com
# GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
# EMAIL_NAME=Moss & Moon

# --- Real emails (Resend: https://resend.com → API Keys, free tier is fine)
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=Moss & Moon <hello@yourdomain.com>
